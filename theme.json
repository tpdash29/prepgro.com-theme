{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary",      "color": "#2563EB", "name": "Brand Blue" },
				{ "slug": "primary-dark", "color": "#1A4FC4", "name": "Chip Start" },
				{ "slug": "primary-mid",  "color": "#2D7EF5", "name": "Chip Mid" },
				{ "slug": "accent",       "color": "#5299FF", "name": "Chip End" },
				{ "slug": "on-dark",      "color": "#7CB0FF", "name": "On-dark Blue" },
				{ "slug": "ink",          "color": "#0F1419", "name": "Ink" },
				{ "slug": "ink-2",        "color": "#121C30", "name": "Ink Deep" },
				{ "slug": "body",         "color": "#313B4B", "name": "Body Text" },
				{ "slug": "muted",        "color": "#687078", "name": "Muted" },
				{ "slug": "line",         "color": "#E3E8F0", "name": "Hairline" },
				{ "slug": "surface",      "color": "#F5F7FB", "name": "Surface" },
				{ "slug": "base",         "color": "#FFFFFF", "name": "Base" },
				{ "slug": "success",      "color": "#0E9F6E", "name": "Success" },
				{ "slug": "danger",       "color": "#DC2626", "name": "Danger" }
			],
			"gradients": [
				{
					"slug": "chip",
					"name": "PrepGro Chip",
					"gradient": "linear-gradient(135deg, #1A4FC4 0%, #2D7EF5 52%, #5299FF 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Outfit",
					"fontFamily": "'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Outfit (Display)",
					"fontFamily": "'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "sm",   "name": "Small",   "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base",    "size": "1rem",     "fluid": false },
				{ "slug": "lg",   "name": "Large",   "size": "1.25rem",  "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "xl",   "name": "XL",      "size": "1.5rem",   "fluid": { "min": "1.375rem", "max": "1.5rem" } },
				{ "slug": "2xl",  "name": "2XL",     "size": "2.1rem",   "fluid": { "min": "1.75rem", "max": "2.1rem" } },
				{ "slug": "3xl",  "name": "3XL",     "size": "2.9rem",   "fluid": { "min": "2.25rem", "max": "2.9rem" } },
				{ "slug": "4xl",  "name": "Display", "size": "3.8rem",   "fluid": { "min": "2.6rem", "max": "3.8rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "1rem" },
				{ "slug": "40", "name": "3", "size": "1.5rem" },
				{ "slug": "50", "name": "4", "size": "2.5rem" },
				{ "slug": "60", "name": "5", "size": "4rem" },
				{ "slug": "70", "name": "6", "size": "6rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.12"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"border": { "radius": "10px" },
				"spacing": { "padding": { "top": "0.72rem", "bottom": "0.72rem", "left": "1.25rem", "right": "1.25rem" } },
				"typography": { "fontWeight": "600" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--primary-dark)", "text": "#ffffff" }
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-standard",
			"title": "Standard Page (title + content)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
